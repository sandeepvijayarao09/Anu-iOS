<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Partial Info.plist, merged into the one Xcode generates
  (GENERATE_INFOPLIST_FILE = YES). Only keys Xcode has no INFOPLIST_KEY_ build
  setting for belong here.
  - NSAllowsLocalNetworking lets Anu reach Ollama on the user's Mac and A2A
    agents over plain HTTP on the local network only (.local names, unqualified
    names, private addresses). Everything else still needs HTTPS. The app code
    refuses plain HTTP to a non-local host, and the vault never sends a secret
    over it.
  - NSAlarmKitUsageDescription for alarms and timers (AlarmKit).
  - BGTaskSchedulerPermittedIdentifiers + UIBackgroundModes "processing" for
    Memory v2 learning while the phone charges.
-->
<dict>
	<key>NSAlarmKitUsageDescription</key>
	<string>Anu sets the alarms and timers you ask for, so they ring like the Clock app's.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.anu.app.memory.learn</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
</dict>
</plist>
